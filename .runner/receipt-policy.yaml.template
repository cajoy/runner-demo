# Rendered by scripts/bootstrap.sh into .runner/receipt-policy.yaml.
# CI loads the rendered file from a protected ref, so a candidate commit can
# never widen the trust that verifies it.
schema: runner-receipt-policy/v1

keys:
  local-alex:
    public_key: "@LOCAL_PUBLIC_KEY@"
    repositories: ["@REPOSITORY_ID@"]
    tasks: [lint, unit, build]
    placements: [local]
    platforms: [linux/arm64, linux/amd64]

  github:
    public_key: "@CI_PUBLIC_KEY@"
    repositories: ["@REPOSITORY_ID@"]
    tasks: [lint, unit, build, deploy-github]
    placements: [ci]
    platforms: [linux/amd64]

reuse:
  effects: [none]

branches:
  main: {on_valid: reuse}
  "feat/*": {on_valid: reuse}

tasks:
  lint: {platforms: [linux/arm64, linux/amd64]}
  unit: {platforms: [linux/arm64, linux/amd64]}
  build: {platforms: [linux/arm64, linux/amd64]}
  deploy-github: {platforms: [linux/arm64, linux/amd64]}

on_integrity_conflict: quarantine
